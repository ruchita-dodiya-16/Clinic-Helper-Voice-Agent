# LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Model providers
ANTHROPIC_API_KEY=your_anthropic_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Agent registration name. Keep this same in API and agent worker.
AGENT_NAME=healthcare-helper-agent

# Fast low-latency defaults. Change model IDs if your account uses different names.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CARTESIA_STT_MODEL=ink-2
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_TTS_SPEED=0.92

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Storage: Postgres (local via docker-compose.yml by default) ---
# start.sh brings this up automatically with `docker compose up -d db`.
# Point this at a hosted Postgres instead when you're ready to go beyond local dev.
DATABASE_URL=postgresql+asyncpg://careconnect:careconnect@localhost:5433/careconnect

# --- Telephony (Twilio Elastic SIP Trunk <-> LiveKit SIP) ---
# Fill these in after the Twilio console steps in README.md, then run:
#   python -m scripts.provision_sip
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Printed by scripts/provision_sip.py — paste the values it gives you here.
SIP_INBOUND_TRUNK_ID=
SIP_OUTBOUND_TRUNK_ID=

# Real staff phone number for live escalation transfer (E.164, e.g. +14155551234).
# Leave blank to skip live transfer (escalations still log to the dashboard).
STAFF_TRANSFER_NUMBER=

# --- Retention / re-engagement scheduler ---
CLINIC_TIMEZONE=America/New_York
RETENTION_POLL_MINUTES=30
RETENTION_QUIET_HOURS_START=09:00
RETENTION_QUIET_HOURS_END=18:00
RETENTION_MAX_ATTEMPTS=3
RETENTION_RETRY_DAYS=2
RETENTION_INACTIVE_DAYS=180
