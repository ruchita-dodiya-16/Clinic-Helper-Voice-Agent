LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret


ANTHROPIC_API_KEY=your_anthropic_api_key
CARTESIA_API_KEY=your_cartesia_api_key

AGENT_NAME=healthcare-helper-agent

# --- Model / voice tuning  (used by: agent) ---
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CARTESIA_STT_MODEL=ink-2
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_TTS_SPEED=0.90

# --- Web server  (used by: api) ---
# Use 0.0.0.0 in Docker so the container is reachable; 127.0.0.1 for local-only.
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database  (used by: api, agent, retention, migrate, seed) ---
# In Docker this is set automatically by docker-compose (the `db` container).
# Only uncomment below if you run WITHOUT Docker:
# DATABASE_URL=postgresql+asyncpg://careconnect:careconnect@localhost:5433/careconnect

# --- Telephony: Twilio SIP trunk  (used by: agent, retention)  [optional] ---
# Needed for REAL phone calls. The browser mic demo works without these.
# Fill in after the Twilio steps in README.md, then run:
#   docker compose run --rm agent python -m scripts.provision_sip
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Printed by scripts/provision_sip.py — paste the values it gives you here.
SIP_INBOUND_TRUNK_ID=
SIP_OUTBOUND_TRUNK_ID=

# Staff number for live escalation transfer (E.164, e.g. +14155551234).
# Blank = skip live transfer (escalations still log to the dashboard).
STAFF_TRANSFER_NUMBER=

# --- Retention / re-engagement scheduler  (used by: retention) ---
CLINIC_TIMEZONE=America/New_York
RETENTION_POLL_MINUTES=30
RETENTION_QUIET_HOURS_START=09:00
RETENTION_QUIET_HOURS_END=18:00
RETENTION_MAX_ATTEMPTS=3
RETENTION_RETRY_DAYS=2
RETENTION_INACTIVE_DAYS=180

# --- Demo / testing  (used by: seed) ---
# All seeded patients use this number, and it's what dashboard calls dial.
TEST_PATIENT_PHONE=+15551234567
