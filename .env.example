# LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Model providers
ANTHROPIC_API_KEY=your_anthropic_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Agent registration name. Keep this same in API and agent worker.
AGENT_NAME=healthcare-helper-agent

# Fast low-latency defaults. Change model IDs if your account uses different names.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
CARTESIA_STT_MODEL=ink-2
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_TTS_SPEED=1.08

# App settings
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=./data/healthcare_helper.sqlite3
